generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  password      String
  firstName     String?
  lastName      String?
  phone         String?
  role          UserRole       @default(CUSTOMER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  addresses     Address[]
  cartItems     CartItem[]
  orders        Order[]
  subscriptions Subscription[]

  @@map("users")
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  name         String?
  streetLine1  String
  streetLine2  String?
  city         String
  province     String
  postalCode   String
  instructions String?
  deliveryZone String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders       Order[]

  @@map("addresses")
}

model Meal {
  id              String           @id @default(cuid())
  name            String
  nameZh          String?
  description     String
  category        MealCategory
  imageUrl        String?
  imageAlt        String?
  price           Decimal          @db.Decimal(10, 2)
  calories        Int?
  protein         Float?
  carbs           Float?
  fat             Float?
  fiber           Float?
  sugar           Float?
  sodium          Float?
  allergens       String[]
  isVegetarian    Boolean          @default(false)
  isVegan         Boolean          @default(false)
  isGlutenFree    Boolean          @default(false)
  isDairyFree     Boolean          @default(false)
  chefName        String?
  chefInfo        String?
  isActive        Boolean          @default(true)
  inventory       Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  cartItems       CartItem[]
  mealSelections  MealSelection[]
  orderItems      OrderItem[]
  weeklyMenuItems WeeklyMenuItem[]

  @@map("meals")
}

model WeeklyMenu {
  id          String           @id @default(cuid())
  name        String
  weekStart   DateTime
  weekEnd     DateTime
  isActive    Boolean          @default(false)
  isPublished Boolean          @default(false)
  publishedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  menuItems   WeeklyMenuItem[]

  @@map("weekly_menus")
}

model WeeklyMenuItem {
  id             String     @id @default(cuid())
  weeklyMenuId   String
  mealId         String
  isAvailable    Boolean    @default(true)
  inventoryLimit Int?
  specialPrice   Decimal?   @db.Decimal(10, 2)
  createdAt      DateTime   @default(now())
  meal           Meal       @relation(fields: [mealId], references: [id])
  weeklyMenu     WeeklyMenu @relation(fields: [weeklyMenuId], references: [id], onDelete: Cascade)

  @@unique([weeklyMenuId, mealId])
  @@map("weekly_menu_items")
}

model Order {
  id                  String        @id @default(cuid())
  orderNumber         String        @unique
  userId              String?
  status              OrderStatus   @default(PENDING)
  orderType           OrderType     @default(ONE_TIME)
  totalAmount         Decimal       @db.Decimal(10, 2)
  deliveryFee         Decimal       @default(0) @db.Decimal(10, 2)
  tax                 Decimal       @default(0) @db.Decimal(10, 2)
  finalAmount         Decimal       @db.Decimal(10, 2)
  addressId           String?
  deliveryDate        DateTime
  deliveryWindow      String
  deliveryNotes       String?
  customerEmail       String?
  customerPhone       String?
  customerName        String?
  needsInsulatedBag   Boolean       @default(false)
  specialInstructions String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  bundlePriceId       String?
  subscriptionId      String?
  orderItems          OrderItem[]
  address             Address?      @relation(fields: [addressId], references: [id])
  bundlePrice         BundlePrice?  @relation("BundleOrders", fields: [bundlePriceId], references: [id])
  subscription        Subscription? @relation("SubscriptionOrders", fields: [subscriptionId], references: [id])
  user                User?         @relation(fields: [userId], references: [id])
  payments            Payment[]

  @@map("orders")
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  mealId     String
  quantity   Int
  unitPrice  Decimal  @db.Decimal(10, 2)
  totalPrice Decimal  @db.Decimal(10, 2)
  mealName   String
  mealNameZh String?
  createdAt  DateTime @default(now())
  meal       Meal     @relation(fields: [mealId], references: [id])
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model DeliveryZone {
  id             String   @id @default(cuid())
  name           String
  postalCodeList String[]
  isActive       Boolean  @default(true)
  deliveryFee    Decimal  @db.Decimal(10, 2)
  deliveryDays   String[]
  maxOrders      Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("delivery_zones")
}

model Payment {
  id                    String        @id @default(cuid())
  orderId               String
  amount                Decimal       @db.Decimal(10, 2)
  currency              String        @default("CAD")
  status                PaymentStatus @default(PENDING)
  paymentMethod         String
  stripePaymentIntentId String?
  stripeClientSecret    String?
  metadata              Json?
  failureReason         String?
  retryCount            Int           @default(0)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String?
  sessionId String?
  mealId    String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  meal      Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mealId])
  @@unique([sessionId, mealId])
  @@map("cart_items")
}

model BundlePrice {
  id                String         @id @default(cuid())
  mealCount         Int            @unique
  oneTimePrice      Decimal        @db.Decimal(10, 2)
  subscriptionPrice Decimal        @db.Decimal(10, 2)
  isActive          Boolean        @default(true)
  description       String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  orders            Order[]        @relation("BundleOrders")
  subscriptions     Subscription[]

  @@map("bundle_prices")
}

model Subscription {
  id                String             @id @default(cuid())
  userId            String
  bundlePriceId     String
  status            SubscriptionStatus @default(ACTIVE)
  deliveryDay       DeliveryDay
  billingCycle      BillingCycle       @default(WEEKLY)
  nextBillingDate   DateTime
  lastBillingDate   DateTime?
  selectionDeadline DateTime
  paymentMethodId   String?
  pausedUntil       DateTime?
  autoRenew         Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  mealSelections    MealSelection[]
  orders            Order[]            @relation("SubscriptionOrders")
  bundlePrice       BundlePrice        @relation(fields: [bundlePriceId], references: [id])
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model MealSelection {
  id             String       @id @default(cuid())
  subscriptionId String
  weekStart      DateTime
  mealId         String
  quantity       Int          @default(1)
  isAutoSelected Boolean      @default(false)
  selectedAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  meal           Meal         @relation(fields: [mealId], references: [id])
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, weekStart, mealId])
  @@map("meal_selections")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum MealCategory {
  RICE_BASED
  NOODLE_SOUPS
  PASTA_FUSION
  PROTEIN_SIDES
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum OrderType {
  ONE_TIME
  SUBSCRIPTION
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  PENDING_CANCELLATION
  PAYMENT_FAILED
}

enum DeliveryDay {
  SUNDAY
  WEDNESDAY
}

enum BillingCycle {
  WEEKLY
  MONTHLY
}
